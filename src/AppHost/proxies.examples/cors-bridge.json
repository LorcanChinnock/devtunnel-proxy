{
  "DevTunnel": {
    "AnonymousAccess": true
  },
  "Cors": {
    "Policies": {
      "Spa": {
        "AllowedOrigins": ["https://my-spa.example.com"],
        "AllowedMethods": ["GET", "POST"],
        "AllowedHeaders": ["*"],
        "AllowCredentials": false
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "default": {
        "ClusterId": "default",
        "CorsPolicy": "Spa",
        "Match": { "Path": "{**catch-all}" }
      }
    },
    "Clusters": {
      "default": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5050/" }
        }
      }
    }
  }
}
