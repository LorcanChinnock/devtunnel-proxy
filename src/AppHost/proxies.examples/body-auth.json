{
  "DevTunnel": {
    "AnonymousAccess": true
  },
  "ReverseProxy": {
    "Routes": {
      "default": {
        "ClusterId": "default",
        "Match": { "Path": "{**catch-all}" },
        "Metadata": {
          "InjectJsonField.AuthToken": "your-server-side-secret",
          "InjectJsonField.Count": "42",
          "InjectJsonField.Nested": "{\"k\":\"v\"}"
        }
      }
    },
    "Clusters": {
      "default": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5050/" }
        }
      }
    }
  }
}
