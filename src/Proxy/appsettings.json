{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Policies": {
      "default": {
        "AllowedOrigins": ["*"],
        "AllowedMethods": ["*"],
        "AllowedHeaders": ["*"],
        "ExposedHeaders": [],
        "AllowCredentials": false
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "default": {
        "ClusterId": "default",
        "CorsPolicy": "default",
        "Match": { "Path": "{**catch-all}" },
        "Transforms": [
          { "RequestHeader": "X-Injected-Header", "Set": "replace-or-remove-me" }
        ],
        "Metadata": {
          "InjectJsonField:InjectedField": "replace-or-remove-me"
        }
      }
    },
    "Clusters": {
      "default": {
        "Destinations": {
          "primary": { "Address": "https://example.com/" }
        }
      }
    }
  }
}
